{
  "name": "blue-koi-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && npx wrangler deploy",
    "db:local": "npx wrangler d1 migrations apply blue-koi-store --local",
    "db:remote": "npx wrangler d1 migrations apply blue-koi-store --remote",
    "test:browser": "node tests/browser-check.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.135.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true
  }
}
