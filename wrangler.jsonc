{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blue-koi-storefront",
	"main": "server/worker.mjs",
	"compatibility_date": "2026-09-18",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blue-koi-store",
			"database_id": "bf52761f-0bec-4b08-b997-f7afdccfb3d6",
			"migrations_dir": "migrations"
		},
		{
			"binding": "blue_koi_store",
			"database_name": "blue-koi-store",
			"database_id": "bf52761f-0bec-4b08-b997-f7afdccfb3d6"
		}
	],
	"vars": {
		"STORE_MODE": "preview",
		"SITE_URL": "https://bluekoibotanicals.com",
		"SQUARE_ENVIRONMENT": "sandbox",
		"SQUARE_API_VERSION": "2026-09-16",
		"SQUARE_APPLICATION_ID": "sandbox-sq0idb-7v3qfzTdMDxQM3USbIqj-w",
		"SQUARE_LOCATION_ID": "LG2FGSESN4FV0",
		"EMAIL_FROM": "Blue Koi Botanicals <orders@bluekoibotanicals.com>",
		"LIVE_LAUNCH_CONFIRMED": "false",
		"SQUARE_WEBHOOK_URL": "https://bluekoibotanicals.com/api/webhooks/square",
		"CUSTOMS_SIGNER": "Gwyn Porter"
	},
	"triggers": {
		"crons": [
			"15 * * * *"
		]
	}
}